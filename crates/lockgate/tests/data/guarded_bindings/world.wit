package test:guarded@1.2.3;

interface vm {
  enum vm-error {
    not-found,
    denied,
  }

  create: func(pool: string) -> result<string, vm-error>;
  exec: func(vm: string, command: string) -> result<string, vm-error>;
  destroy: func(vm: string) -> result<_, vm-error>;
  list-pools: func() -> result<list<string>, vm-error>;
  protocol-version: func() -> string;
}

interface admin {
  enum admin-error {
    denied,
  }

  restart: func() -> result<_, admin-error>;
  status: func() -> result<_, admin-error>;
}

interface mixed {
  enum mixed-error {
    denied,
  }

  vm-action: func() -> result<string, mixed-error>;
  admin-action: func() -> result<string, mixed-error>;
  protocol-version: func() -> string;
}

interface guest {
  create: func(pool: string) -> string;
  exec: func(vm: string, command: string) -> string;
  destroy: func(vm: string) -> string;
  list-pools: func() -> string;
  protocol-version: func() -> string;
  mixed-vm: func() -> string;
  mixed-admin: func() -> string;
  mixed-version: func() -> string;
}

world fixture {
  import vm;
  import admin;
  import mixed;
  export guest;
}

world vm-only {
  import vm;
}

world vm-runtime {
  import vm;
  import mixed;
  export guest;
}
